# ==============================================================================
# SECRETS & SENSITIVE ENVIRONMENT VARIABLES (NEVER COMMIT)
# ==============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env.*.local

# Allow example environment configuration templates
!.env.example
!**/.env.example

# ==============================================================================
# VECTOR DATABASE & RUNTIME STORAGE (GENERATED DYNAMICALLY)
# ==============================================================================
qdrant_storage/
**/qdrant_storage/
*.lock
**/*.lock
.lock

# ==============================================================================
# PYTHON & ML ARTIFACTS
# ==============================================================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/

# ==============================================================================
# NODE / REACT FRONTEND
# ==============================================================================
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================================================================
# JAVA / SPRING BOOT & MAVEN
# ==============================================================================
target/
**/target/
.mvn/wrapper/maven-wrapper.jar
**/apache-maven-*/
tools/apache-maven-*/
**/tools/apache-maven-*/

### STS & Eclipse ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/

# ==============================================================================
# LOGS, RUNTIME PIDS & TEMPORARY FILES
# ==============================================================================
*.log
**/*.log
*.pid
**/*.pid
.supervisor.pid
scratch/
**/scratch/

# ==============================================================================
# IDE, EDITORS & OPERATING SYSTEM ARTIFACTS
# ==============================================================================
.idea/
**/.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
