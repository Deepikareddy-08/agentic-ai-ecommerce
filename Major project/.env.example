# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/ecommerce_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# Backend Spring Boot Configuration
SERVER_PORT=8080
JWT_SECRET=your_jwt_256bit_secret_key_change_in_production_min_32_chars
JWT_EXPIRATION_MS=86400000

# Service URLs
ML_SERVICE_URL=http://localhost:8001
AI_SERVICE_URL=http://localhost:8002
SPRING_BACKEND_URL=http://localhost:8080
DB_POOL_SIZE=10

# Qdrant Vector DB (In-memory or local storage used by default; set URL for remote cluster)
QDRANT_URL=
QDRANT_API_KEY=

# LLM Provider Configuration (Choose Groq, OpenAI, or Ollama)
# For Groq:
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=450
# Or OpenAI:
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini
